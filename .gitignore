# Headless-browser profiles. Chrome writes these into the working directory when it is run
# without --user-data-dir, and the Pages workflow uploads the repo root verbatim, so a stray
# profile gets served from otianai.com. 44 MB of them shipped on 2026-08-11.
cp[0-9]*/
