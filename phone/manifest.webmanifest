{
  "name": "Archie on your phone",
  "short_name": "Archie",
  "description": "Manage the Archie agent running on your computer, from your phone.",
  "start_url": "/phone/",
  "_scope_note": "Wider than start_url on purpose. Signing in navigates to /login/, and account pages live at /account/ and /billing/; with a scope of /phone/ every one of those is out of scope, so the standalone app kicks you out to the browser mid-sign-in and loses the app's own storage in the process. The app stays Archie-only through its navigation (see .is-app in styles.css), not by fencing off the paths it needs to work.",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#faf7f2",
  "theme_color": "#faf7f2",
  "icons": [
    {
      "src": "/assets/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
